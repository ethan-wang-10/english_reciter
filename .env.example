# 复制为 .env 后填写（.gitignore 已忽略 .env，勿提交真实密钥）
# 生成随机密钥: openssl rand -hex 32
SECRET_KEY=

# 可选：DeepSeek 对话模型（默认 deepseek-v4-flash，非思考模式在代码中固定关闭）
# DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# 可选：DeepSeek 新词库生成（deepseek_generate_word_entries_v2）调试时输出完整 prompt/回复（日志量大）
# ENGLISH_RECITER_DEEPSEEK_V2_DEBUG=1
