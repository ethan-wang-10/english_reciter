# 复制为 .env 后填写（.gitignore 已忽略 .env，勿提交真实密钥）
# 生成随机密钥: openssl rand -hex 32
SECRET_KEY=
TZ=Asia/Shanghai

# 可选：全新部署可配置未使用邀请码的专用加密密钥，配置后须保持稳定。
# 已存在的 .invite_code_fernet.key 优先；未配置时会自动创建，请随数据一起备份。
# INVITE_CODE_ENCRYPTION_SECRET=

# 密码找回邮件（以下示例适用于常见的 465/SSL SMTP；密码通常应填写邮箱授权码）
# PUBLIC_BASE_URL=https://your-domain.example
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_FROM_NAME=智能英语背诵
# SMTP_USE_SSL=true
# SMTP_STARTTLS=false
# SMTP_TIMEOUT=15
# PASSWORD_RESET_TTL_MINUTES=30
# PASSWORD_RESET_COOLDOWN_SECONDS=60

# 可选：DeepSeek 对话模型（默认 deepseek-v4-flash；批量结构化生成关闭思考模式）
# DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# 高考题后台补全：默认启用；缺题达到 30 个后仅在 DeepSeek 官方低峰执行。
# 每次任务领取 30 个，固定拆成 3 个 10 词请求；至少间隔 30 分钟。
# GAOKAO_AUTO_BACKFILL_ENABLED=true
# GAOKAO_AUTO_BACKFILL_CHECK_SECONDS=300
# GAOKAO_AUTO_BACKFILL_MIN_INTERVAL_SECONDS=1800

# 可选：DeepSeek 新词库生成（deepseek_generate_word_entries_v2）调试时输出完整 prompt/回复（日志量大）
# ENGLISH_RECITER_DEEPSEEK_V2_DEBUG=1
# DEEPSEEK_DEBUG_CONTENT_LOGS=1

# 长任务与缓存（生产默认启用后台导入；Piper 缓存默认 30 天/2000 个/512 MiB）
# IMPORT_JOBS_ASYNC=true
# IMPORT_JOB_RETENTION_DAYS=14
# RECITER_CACHE_MAX_USERS=24
# RECITER_CACHE_TTL_SECONDS=1800
# PIPER_CACHE_DIR=user_data_simple/_shared/tts_cache
# PIPER_CACHE_MAX_AGE_DAYS=30
# PIPER_CACHE_MAX_FILES=2000
# PIPER_CACHE_MAX_BYTES=536870912
# RECITER_LOG_MAX_BYTES=10485760
# RECITER_LOG_BACKUP_COUNT=5

# 可选：性能采集（默认开启，写入 user_data_simple/_shared/performance/*.jsonl）
# PERF_MONITOR_ENABLED=true
# PERF_SHARE_SECRET=
# PERF_SLOW_REQUEST_MS=1000
# PERF_BACKEND_SAMPLE_RATE=0.02
# PERF_BROWSER_SAMPLE_RATE=1.0
# PERF_RETENTION_DAYS=30
